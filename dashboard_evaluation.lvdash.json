{
  "datasets": [
    {
      "name": "c3207456",
      "displayName": "exactitude",
      "queryLines": [
        "SELECT CASE WHEN a.config LIKE 'multi%' THEN '3 agents' ELSE 'Agent unique' END AS config,\r\n",
        "       CASE WHEN a.config LIKE 'multi%' THEN '3 agents - passe 1'\r\n",
        "            WHEN a.batch_id LIKE '20261118_205533%' THEN 'Agent unique - run préliminaire'\r\n",
        "            ELSE CONCAT('Agent unique - passe ', a.run) END AS execution,\r\n",
        "       a.batch_id, a.run,\r\n",
        "       COUNT(*) AS n_cases,\r\n",
        "       SUM(CASE WHEN a.predicted = k.expected_root_cause THEN 1 ELSE 0 END) AS n_correct,\r\n",
        "       ROUND(100.0 * SUM(CASE WHEN a.predicted = k.expected_root_cause THEN 1 ELSE 0 END) / COUNT(*), 1) AS accuracy_pct\r\n",
        "FROM workspace.forecast_debug.agent_runs_v2 a\r\n",
        "JOIN workspace.forecast_debug.known_issues k ON a.case_id = k.case_id\r\n",
        "WHERE a.batch_id <> '20261118_205533_6ebf80'\r\n",
        "GROUP BY 1, 2, a.batch_id, a.run\r\n",
        "ORDER BY a.batch_id, a.run"
      ]
    },
    {
      "name": "4e5df52e",
      "displayName": "par_cas",
      "queryLines": [
        "-- 2. Résultat par cas (repérer les erreurs et l'instabilité)\r\n",
        "SELECT a.case_id, k.expected_root_cause AS attendu, a.config, a.run,\r\n",
        "       a.predicted AS predit, a.confidence,\r\n",
        "       a.predicted = k.expected_root_cause AS correct\r\n",
        "FROM workspace.forecast_debug.agent_runs_v2 a\r\n",
        "JOIN workspace.forecast_debug.known_issues k ON a.case_id = k.case_id\r\n",
        "WHERE a.batch_id <> '20261118_205533_6ebf80'\r\n",
        "ORDER BY a.case_id, a.config, a.run;\r\n"
      ]
    },
    {
      "name": "20bbe2e5",
      "displayName": "cout",
      "queryLines": [
        "SELECT CASE WHEN config LIKE 'multi%' THEN '3 agents' ELSE 'Agent unique' END AS config,\r\n",
        "       ROUND(AVG(n_llm), 1) AS appels_llm_moyens,\r\n",
        "       ROUND(AVG(seconds), 1) AS secondes_moyennes,\r\n",
        "       SUM(CASE WHEN repaired THEN 1 ELSE 0 END) AS relances_de_format\r\n",
        "FROM workspace.forecast_debug.agent_runs_v2\r\n",
        "WHERE batch_id <> '20261118_205533_6ebf80'\r\n",
        "GROUP BY 1"
      ]
    }
  ],
